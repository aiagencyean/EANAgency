<script is:inline>
(function () {
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.getElementById("y").textContent = new Date().getFullYear();

  /* ---- intro lock + hero word reveal ---- */
  var body = document.body;
  if (!reduce) {
    body.classList.add("lock");
    setTimeout(function () { body.classList.remove("lock"); }, 3250);
    setTimeout(function () { body.classList.add("go"); }, 2450);
    var ws = document.querySelectorAll("h1 .w");
    ws.forEach(function (w, i) { w.style.animationDelay = (2.5 + i * 0.09) + "s"; });
  } else {
    body.classList.add("go");
  }

  /* ---- scroll progress ---- */
  var prog = document.getElementById("prog");
  function onScroll() {
    var h = document.documentElement;
    var p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
    prog.style.width = (p * 100) + "%";
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* ---- reveal ---- */
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add("in");
      io.unobserve(e.target);
      var cs = e.target.querySelectorAll("[data-count]");
      cs.forEach(countUp);
    });
  }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
  document.querySelectorAll(".rv").forEach(function (el) { io.observe(el); });

  /* hero meta count-up (runs after intro) */
  setTimeout(function () {
    document.querySelectorAll(".hero__meta [data-count]").forEach(countUp);
  }, reduce ? 0 : 3400);

  function countUp(el) {
    if (el.dataset.done) return;
    el.dataset.done = "1";
    var target = parseInt(el.dataset.count, 10) || 0;
    var suffix = el.dataset.suffix || "";
    if (reduce) { el.textContent = target + suffix; return; }
    var t0 = performance.now(), dur = 900;
    function step(t) {
      var k = Math.min(1, (t - t0) / dur);
      k = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(target * k) + suffix;
      if (k < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  /* ---- ember field ---- */
  if (!reduce) {
    var c = document.getElementById("embers"), x = c.getContext("2d");
    var W, H, dpr = Math.min(window.devicePixelRatio || 1, 2), parts = [];
    function size() {
      W = c.clientWidth; H = c.clientHeight;
      c.width = W * dpr; c.height = H * dpr; x.setTransform(dpr, 0, 0, dpr, 0, 0);
      var n = Math.min(90, Math.round(W * H / 22000));
      parts = [];
      for (var i = 0; i < n; i++) parts.push(mk(Math.random() * H));
    }
    function mk(y) {
      return { x: Math.random() * W, y: y, r: Math.random() * 1.6 + 0.4, s: Math.random() * 0.35 + 0.08, a: Math.random() * 0.5 + 0.1, drift: (Math.random() - 0.5) * 0.25 };
    }
    function tick() {
      x.clearRect(0, 0, W, H);
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        p.y -= p.s; p.x += p.drift;
        if (p.y < -10) { parts[i] = mk(H + 10); continue; }
        x.beginPath();
        x.fillStyle = "rgba(217,180,91," + p.a + ")";
        x.arc(p.x, p.y, p.r, 0, 6.283);
        x.fill();
      }
      requestAnimationFrame(tick);
    }
    size();
    tick();
    var rt;
    window.addEventListener("resize", function () { clearTimeout(rt); rt = setTimeout(size, 200); });
  }
})();
</script>

<script is:inline>
/* ============ Kontaktformular (Web3Forms) ============ */
(function () {
  var WEB3FORMS_KEY = ""; /* Key von web3forms.com eintragen → dann sendet das Formular echt */
  var lead = document.getElementById("leadForm");
  if (!lead) return;
  var leadStatus = document.getElementById("leadStatus");
  var leadBtn = document.getElementById("leadBtn");
  function lf(n) { return lead.querySelector('[name="' + n + '"]'); }

  lead.addEventListener("submit", function (e) {
    e.preventDefault();
    if (lf("botcheck").checked) return;
    var data = { name: lf("name").value.trim(), email: lf("email").value.trim(), company: lf("company").value.trim(), message: lf("message").value.trim() };
    if (!data.name || !data.email || !data.message) return;
    leadBtn.disabled = true;
    leadStatus.className = "frm__status"; leadStatus.textContent = "Wird gesendet …";
    function ok(demo) {
      leadStatus.className = "frm__status ok";
      leadStatus.textContent = "Ihre Anfrage ist raus. Wir melden uns unter " + data.email + ". Eine Bestätigung liegt gleich im Postfach." + (demo ? "  (Demo – noch keine echte E-Mail: Zugangsschlüssel fehlt.)" : "");
      if (!demo) lead.reset();
      leadBtn.disabled = false;
    }
    function fail() {
      leadStatus.className = "frm__status err";
      leadStatus.textContent = "Senden hat nicht geklappt. Bitte direkt an aiagencyean@outlook.com schreiben.";
      leadBtn.disabled = false;
    }
    if (!WEB3FORMS_KEY) { setTimeout(function () { ok(true); }, 700); return; }
    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ access_key: WEB3FORMS_KEY, subject: "Neue Anfrage über die Website – " + data.name, from_name: "EAN Agency Website", name: data.name, email: data.email, Betrieb: data.company || "–", message: data.message })
    }).then(function (r) { return r.json(); }).then(function (j) { j && j.success ? ok(false) : fail(); }).catch(fail);
  });
})();
</script>
