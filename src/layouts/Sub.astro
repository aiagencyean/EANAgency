---
const { title, heading, lead } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} — EAN Agency</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

<style is:inline>
  :root {
    --void: #08080A; --void-2: #100E12; --bone: #F2EEE4; --bone-dim: #9A9488;
    --gold: #D9B45B; --gold-bright: #F7E7B6; --line: rgba(217,180,91,0.16); --line-2: rgba(217,180,91,0.42);
    --font-display: "Syne", system-ui, sans-serif;
    --font-serif: "Instrument Serif", Georgia, serif;
    --font-body: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
    color-scheme: dark;
  }
  * , *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--void); color: var(--bone); font-family: var(--font-body); font-size: 1.05rem; line-height: 1.62; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 1px solid var(--gold); outline-offset: 4px; }
  .wrap { max-width: 1040px; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 3.5rem); }

  .subbar { position: sticky; top: 0; z-index: 20; background: linear-gradient(var(--void), color-mix(in srgb, var(--void) 20%, transparent)); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .subbar .wrap { display: flex; align-items: center; justify-content: space-between; padding-block: 1rem; }
  .subbar .home { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 800; letter-spacing: 0.08em; font-size: 0.92rem; }
  .subbar .home b { font-family: var(--font-mono); font-weight: 500; font-size: 0.58rem; letter-spacing: 0.1em; border: 1px solid var(--line-2); color: var(--gold); padding: 0.22rem 0.4rem; }
  .subbar nav { display: flex; gap: 1.6rem; font-size: 0.82rem; color: var(--bone-dim); }
  .subbar nav a:hover { color: var(--bone); }
  @media (max-width: 640px) { .subbar nav { display: none; } }

  .pagehead { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3.5rem); }
  .pagehead .back { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); }
  .pagehead h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; letter-spacing: -0.03em; margin: 1.4rem 0 0; }
  .pagehead .lead { margin: 1.2rem 0 0; color: var(--bone-dim); max-width: 48ch; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.4; }

  main.wrap { padding-bottom: clamp(4rem, 10vw, 7rem); }

  .btn { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.4rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--void); background: var(--gold); border: 1px solid var(--gold); cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 40px -12px rgba(217,180,91,0.5); }
  .btn--ghost { background: transparent; color: var(--bone); border-color: var(--line-2); }
  .btn--ghost:hover { border-color: var(--gold); color: var(--gold); }
  .btn--sm { padding: 0.6rem 1rem; }

  .card { border: 1px solid var(--line); background: var(--void-2); padding: clamp(1.4rem, 3.5vw, 2.2rem); }
  .cta-strip { margin-top: clamp(3rem, 7vw, 5rem); padding-top: 2rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; }
  .cta-strip p { margin: 0; color: var(--bone-dim); }

  /* calendar */
  .cal__svc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }
  .cal__svc button { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bone-dim); background: transparent; border: 1px solid var(--line-2); padding: 0.5rem 0.85rem; cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s; }
  .cal__svc button[aria-pressed="true"] { color: var(--void); background: var(--gold); border-color: var(--gold); }
  .cal__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .cal__day { background: var(--void); padding: 0.7rem 0.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .cal__day h4 { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bone-dim); margin: 0 0 0.3rem; text-align: center; }
  .slot { font-family: var(--font-mono); font-size: 0.72rem; padding: 0.42rem 0.2rem; text-align: center; border: 1px solid var(--line-2); background: transparent; color: var(--bone); cursor: pointer; transition: color 0.15s, background 0.15s, border-color 0.15s; }
  .slot:hover:not(.is-blocked) { border-color: var(--gold); color: var(--gold); }
  .slot[aria-pressed="true"] { background: var(--gold); color: var(--void); border-color: var(--gold); }
  .slot.is-blocked { color: #4b473d; border-color: var(--line); text-decoration: line-through; cursor: not-allowed; }
  .slot.is-blocked:hover { border-color: var(--line-2); color: #6b6558; }
  .cal__msg { margin-top: 1rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--gold); min-height: 1.2em; }
  .cal__confirm { margin-top: 1.2rem; display: none; gap: 0.8rem; flex-wrap: wrap; align-items: flex-end; }
  .cal__confirm.on { display: flex; }
  .cal__confirm label { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-dim); }
  .cal__confirm input { background: var(--void); border: 1px solid var(--line-2); color: var(--bone); font-family: var(--font-body); font-size: 0.92rem; padding: 0.55rem 0.7rem; min-width: 12rem; }
  .cal__done { margin-top: 1.2rem; display: none; border: 1px solid var(--line-2); padding: 1.2rem; }
  .cal__done.on { display: block; }
  .cal__done b { color: var(--gold); font-family: var(--font-display); }
  .cal__done .fine { margin: 0.6rem 0 1rem; font-size: 0.8rem; color: var(--bone-dim); }
  .demo-note { margin-top: 1.2rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bone-dim); opacity: 0.8; }
  @media (max-width: 720px) { .cal__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 440px) { .cal__grid { grid-template-columns: 1fr; } }

  /* chat */
  .chat__log { min-height: 13rem; max-height: 26rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; padding-right: 0.3rem; }
  .bub { max-width: 88%; padding: 0.65rem 0.85rem; font-size: 0.92rem; line-height: 1.5; border: 1px solid var(--line-2); white-space: pre-wrap; }
  .bub.bot { align-self: flex-start; background: rgba(217, 180, 91, 0.06); }
  .bub.me { align-self: flex-end; background: rgba(255, 255, 255, 0.05); }
  .bub .jump { display: inline-block; margin-top: 0.55rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--gold); padding: 0.3rem 0.65rem; cursor: pointer; background: transparent; }
  .bub .jump:hover { background: var(--gold); color: var(--void); }
  .chat__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.9rem 0; }
  .chip { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bone-dim); border: 1px solid var(--line-2); padding: 0.34rem 0.62rem; cursor: pointer; background: transparent; }
  .chip:hover { color: var(--bone); border-color: var(--gold); }
  .chat__ask { display: flex; gap: 0.5rem; }
  .chat__ask input { flex: 1; background: var(--void); border: 1px solid var(--line-2); color: var(--bone); font-family: var(--font-body); font-size: 0.92rem; padding: 0.7rem 0.9rem; }
  .chat__ask button { width: 3rem; background: transparent; border: 1px solid var(--gold); color: var(--gold); font-size: 1rem; cursor: pointer; }
  .chat__ask button:hover { background: var(--gold); color: var(--void); }

  /* service detail */
  .svc-sec { padding-block: clamp(2.5rem, 6vw, 4rem); border-top: 1px solid var(--line); scroll-margin-top: 5rem; }
  .svc-sec .tag { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); }
  .svc-sec h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.7rem, 4vw, 2.8rem); letter-spacing: -0.025em; margin: 0.8rem 0 0; }
  .svc-sec > p { color: var(--bone-dim); max-width: 60ch; margin: 1rem 0 0; }
  .svc-sec h3 { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bone-dim); margin: 2rem 0 0.8rem; }
  .svc-sec ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
  .svc-sec li { display: flex; gap: 0.7rem; }
  .svc-sec li::before { content: "✦"; color: var(--gold); font-size: 0.75em; line-height: 1.7; }

  footer.sub { border-top: 1px solid var(--line); padding-block: 2.4rem; font-size: 0.8rem; color: var(--bone-dim); }
  footer.sub .wrap { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  footer.sub a:hover { color: var(--bone); }
</style>

<header class="subbar">
  <div class="wrap">
    <a class="home" href="/"><b>EAN</b> AGENCY</a>
    <nav>
      <a href="/leistungen">Leistungen</a>
      <a href="/assistent">KI-Assistent</a>
      <a href="/kalender">Terminkalender</a>
      <a href="/beispiele">Beispiele</a>
    </nav>
  </div>
</header>

<div class="wrap pagehead">
  <a class="back" href="/">← EAN Agency</a>
  <h1>{heading}</h1>
  {lead && <p class="lead">{lead}</p>}
</div>

<main class="wrap">
  <slot />
</main>

<footer class="sub">
  <div class="wrap">
    <span>&copy; {new Date().getFullYear()} EAN Agency</span>
    <a href="mailto:aiagencyean@outlook.com">aiagencyean@outlook.com</a>
  </div>
</footer>

<script is:inline>
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  function ean_toTop() {
    if (location.hash) {
      try { history.replaceState(null, "", location.pathname + location.search); } catch (e) {}
    }
    window.scrollTo(0, 0);
  }
  ean_toTop();
  window.addEventListener("pageshow", ean_toTop);
  window.addEventListener("load", ean_toTop);
  requestAnimationFrame(ean_toTop);
  setTimeout(ean_toTop, 60);
</script>
